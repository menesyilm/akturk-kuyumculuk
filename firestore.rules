rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email == 'kuyumculukakturk@gmail.com';
    }

    function hasOnlyPublicCertificateFields(data) {
      return data.keys().hasOnly([
        'ayar',
        'batchNumber',
        'careInstructions',
        'category',
        'certificateDate',
        'certificateNumber',
        'certificatePartsJson',
        'certificateStatus',
        'certificateUpdatedAt',
        'childProductCodesJson',
        'engravingCodesJson',
        'goldColor',
        'gram',
        'image',
        'lookupCodes',
        'physicalCount',
        'productCode',
        'productName',
        'productType',
        'productionDate',
        'saleType',
        'sira',
        'stoneType',
        'warrantyInfo',
        'warrantyPolicyVersion'
      ]);
    }

    match /yuzukvekupe/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /bileklik/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /kolye/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /set/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Public certificate verification exposes technical data only. Firestore
    // read rules cannot redact fields, so the public collection is kept on an
    // allow-listed technical schema at write time. Lookup queries must also
    // request at most one result. Certificate writes remain staff-only.
    match /sertifikalar/{certificateId} {
      allow get: if isStaff()
        || hasOnlyPublicCertificateFields(resource.data);
      allow list: if isStaff()
        || (request.query.limit != null
          && request.query.limit <= 1);
      allow create, update: if isStaff()
        && hasOnlyPublicCertificateFields(request.resource.data);
      allow delete: if isStaff();
    }

    // Legacy collection kept for backward compatibility.
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
